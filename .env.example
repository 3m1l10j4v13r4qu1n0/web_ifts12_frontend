# URL base del backend IFTS N.º 12.
#
# El cliente agrega solo el prefijo /api, así que acá va la raíz del servidor.
# El backend declara el puerto 5000 en app.py:120 y sirve en 0.0.0.0.
#
# Desarrollo local (backend corriendo con `python app.py`):
VITE_API_BASE_URL=http://localhost:5000

# @TODO: Backend e Infra deben confirmar la URL del entorno desplegado. El frontend se
# sirve como build estático en un VPS, así que probablemente sea un subdominio distinto al
# del Moodle. Ver pregunta P9 de
# documentacion/driveFrontend/04_backend/preguntas_abiertas_2026-10-01.md.

# URLs institucionales. Hoy NO hay valores: no se usan URLs inventadas para enlaces
# oficiales (RN-10, regla anti-alucinación). Se publican cuando IFTS/Dirección entregue
# los enlaces (deuda DB-07).
# VITE_MOODLE_URL=
# VITE_INSCRIPCION_URL=
# VITE_SIU_URL=
# Banderas de módulos que todavía no están en el contrato de API
# (inbox/apispec_1.json, 22/10/2026). Ver docs/06_audits/audit_2026-10-22-backend.md.
#
# Default: habilitados en desarrollo/test y deshabilitados en producción. Un valor
# explícito siempre gana sobre el default. Valores: 1/true/on/si | 0/false/off/no.
#
# Al publicarse el recurso en el apispec, activar la bandera en el entorno que corresponda.
# VITE_NOVEDADES_HABILITADAS=true
# VITE_ADMIN_HABILITADO=true
# VITE_CONTACTO_HABILITADO=true
